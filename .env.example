# ==============================================================================
# ForgeFit Studio - Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# ==============================================================================

# Application Server
PORT=3100
BASE_URL=http://localhost:3100
NODE_ENV=development

# MySQL Database Configuration (XAMPP / MariaDB / Cloud MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=forgefit

# phpMyAdmin Direct Console URL (Optional - used in admin console navbar)
PHPMYADMIN_URL=http://localhost/phpmyadmin/index.php?route=/database/structure&db=forgefit

# Session Security (Generate a secure 64+ char random string for production)
SESSION_SECRET=forgefit_production_super_secret_session_key_replace_this_with_random_string_2026

# Cookie & Reverse Proxy Settings
# Set SECURE_COOKIES=1 only when serving over HTTPS / SSL
SECURE_COOKIES=0
# Set TRUST_PROXY=1 when running behind Nginx, Caddy, Cloudflare, or cPanel Passenger
TRUST_PROXY=0

# SMTP / Email Delivery Configuration (Used for OTP verification & 2FA emails)
# SMTP can also be configured dynamically in Admin -> Settings -> Email (SMTP)
FORGEFIT_SMTP_HOST=smtp.gmail.com
FORGEFIT_SMTP_PORT=465
FORGEFIT_SMTP_USER=your_email@gmail.com
FORGEFIT_SMTP_PASS=your_app_specific_password_here
FORGEFIT_SMTP_SECURE=1
FORGEFIT_SMTP_FROM="ForgeFit Studio <noreply@forgefit.com>"
