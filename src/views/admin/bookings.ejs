<h1>Bookings</h1>
<p class="admin-sub"><%= bookings.length %> booking(s)<%= status ? ` with status “${status}”` : '' %>.</p>
<div class="toolbar">
  <form class="search-form" action="/admin/bookings" method="get">
    <select name="status" onchange="this.form.submit()" style="background: var(--bg-input); border: 1px solid var(--border-card); border-radius: 8px; color: #fff; padding: 9px 14px; font-size: 14px;">
      <option value="">All statuses</option>
      <% ['booked','cancelled','attended'].forEach(function(s) { %>
        <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
      <% }) %>
    </select>
  </form>
</div>
<div class="table-wrap">
  <table class="data">
    <thead>
      <tr>
        <th>Member</th>
        <th>Class</th>
        <th>Booked on</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% bookings.forEach(function(b) { %>
      <tr>
        <td>
          <b style="color: #fff;"><%= b.user_name %></b><br/>
          <span class="muted" style="font-size: 13px;"><%= b.user_email %></span>
        </td>
        <td><%= b.class_title %></td>
        <td class="muted"><%= new Date(b.created_at).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></td>
        <td><span class="badge <%= b.status === 'booked' ? 'info' : b.status === 'attended' ? 'ok' : 'warn' %>"><%= b.status %></span></td>
        <td>
          <div class="row-actions">
            <% if (b.status !== 'attended') { %>
            <form action="/admin/bookings/<%= b.id %>/status" method="post" style="display:inline;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="status" value="attended" />
              <button class="btn btn-ghost btn-sm">Mark attended</button>
            </form>
            <% } %>
            <% if (b.status === 'booked') { %>
            <form action="/admin/bookings/<%= b.id %>/status" method="post" style="display:inline;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="status" value="cancelled" />
              <button class="btn btn-danger btn-sm">Cancel</button>
            </form>
            <% } %>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% if (!bookings.length) { %>
<div class="empty">
  <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(204, 255, 0, 0.08); border: 1px solid rgba(204, 255, 0, 0.25); display: inline-flex; align-items: center; justify-content: center; color: var(--volt); margin-bottom: 12px;">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
  </div>
  <p>No bookings found matching current filters.</p>
</div>
<% } %>
