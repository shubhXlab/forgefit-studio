<h1>Settings</h1>
<p class="admin-sub">Site identity, database setup, and the email server used for OTP codes and notifications.</p>

<div class="form-card wide" style="margin:0 0 24px 0;max-width:none">
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:16px">
    <div>
      <h3 style="margin-bottom:4px">Database (MySQL)</h3>
      <p class="muted" style="font-size:14px;margin:0">Active database engine: <strong>MySQL / MariaDB</strong> (Database: <code><%= config.mysql.database %></code>)</p>
    </div>
    <div>
      <a href="<%= config.phpMyAdminUrl %>" target="_blank" rel="noopener noreferrer" class="btn" style="background:#f29111;color:#fff;display:inline-flex;align-items:center;gap:8px;font-weight:600;text-decoration:none;padding:10px 18px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        Open MySQL in phpMyAdmin ↗
      </a>
    </div>
  </div>
  <div class="field-row">
    <div class="field"><label>MySQL Host & Port</label><input value="<%= config.mysql.host %>:<%= config.mysql.port %>" readonly style="opacity:0.85;cursor:default" /></div>
    <div class="field"><label>MySQL Database</label><input value="<%= config.mysql.database %>" readonly style="opacity:0.85;cursor:default" /></div>
  </div>
  <div class="field-row">
    <div class="field"><label>MySQL User</label><input value="<%= config.mysql.user %>" readonly style="opacity:0.85;cursor:default" /></div>
    <div class="field"><label>phpMyAdmin Direct URL</label><input value="<%= config.phpMyAdminUrl %>" readonly style="opacity:0.85;cursor:default" /></div>
  </div>
</div>

<div class="form-card wide" style="margin:0;max-width:none">
<form action="/admin/settings" method="post">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <h3 style="margin-bottom:16px">Site</h3>
  <div class="field-row">
    <div class="field"><label>Site name</label><input name="site_name" value="<%= settings.site_name %>" maxlength="80" /></div>
    <div class="field"><label>Contact email</label><input name="contact_email" type="email" value="<%= settings.contact_email %>" maxlength="120" placeholder="hello@example.com" /></div>
  </div>
  <hr class="divider" />
  <h3 style="margin-bottom:6px">Email (SMTP)</h3>
  <p class="muted" style="font-size:14px;margin-bottom:16px">Used for registration OTPs, login codes, password resets and booking confirmations. Leave empty to disable email sending (codes are then written to <code>data/mail-dev.log</code> for development).</p>
  <div class="field-row">
    <div class="field"><label>SMTP host</label><input name="smtp_host" value="<%= settings.smtp_host %>" placeholder="mail.example.com" maxlength="120" /></div>
    <div class="field"><label>SMTP port</label><input name="smtp_port" value="<%= settings.smtp_port %>" maxlength="6" placeholder="587" /></div>
  </div>
  <div class="field-row">
    <div class="field"><label>SMTP username</label><input name="smtp_user" value="<%= settings.smtp_user %>" maxlength="120" autocomplete="off" /></div>
    <div class="field"><label>SMTP password</label><input name="smtp_pass" type="password" value="" placeholder="<%= settings.smtp_pass ? '•••••••• (saved — type to replace)' : 'Not set' %>" autocomplete="new-password" /><div class="hint">Leave blank to keep the saved password.</div></div>
  </div>
  <div class="field-row">
    <div class="field"><label>From address</label><input name="smtp_from" value="<%= settings.smtp_from %>" maxlength="120" placeholder="noreply@example.com" /></div>
    <div class="field"><label>Encryption</label><select name="smtp_secure"><option value="0" <%= settings.smtp_secure!=='1'?'selected':'' %>>STARTTLS (port 587)</option><option value="1" <%= settings.smtp_secure==='1'?'selected':'' %>>SSL/TLS (port 465)</option></select></div>
  </div>
  <button class="btn" type="submit">Save settings</button>
</form>
</div>
