<div class="wrap" style="padding-top: 20px; padding-bottom: 40px;">
  <div class="form-card reveal">
    <div style="text-align: center; margin-bottom: 24px;">
      <div class="logo-badge" style="margin: 0 auto 12px; width: 36px; height: 36px;">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor">
          <path d="M4 6h16M4 12h11M4 18h6" stroke="var(--volt)" stroke-width="2.6" stroke-linecap="round"/>
        </svg>
      </div>
      <h1 style="font-size: 26px; margin-bottom: 4px;">Join ForgeFit</h1>
      <p class="form-sub" style="margin-bottom: 0;">Claim your 7-day complimentary pass and reserve your first session.</p>
    </div>

    <form action="/register" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="field">
        <label for="name">Full Name</label>
        <input id="name" name="name" value="<%= form.name || '' %>" placeholder="e.g. Arjun Mehta" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="email">Email Address</label>
        <input id="email" name="email" type="email" value="<%= form.email || '' %>" placeholder="arjun@example.com" required autocomplete="email" />
        <div class="hint" style="color: var(--text-faint); font-size: 12px; margin-top: 4px;">A verification passcode will be sent here.</div>
      </div>
      <div class="field">
        <label for="phone">Phone Number</label>
        <input id="phone" name="phone" type="tel" value="<%= form.phone || '' %>" required autocomplete="tel" placeholder="+91 98765 43210" />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="Minimum 10 characters" required autocomplete="new-password" />
        <div class="pw-meter" id="pwMeter" style="margin-top: 6px;"><i style="transition: width 0.3s ease, background 0.3s ease;"></i></div>
        <div class="hint" style="color: var(--text-faint); font-size: 12px; margin-top: 4px;">At least 10 characters, mixing letters, numbers & symbols.</div>
      </div>
      <div class="field">
        <label for="confirm">Confirm Password</label>
        <input id="confirm" name="confirm" type="password" placeholder="Repeat your password" required autocomplete="new-password" />
      </div>
      <button class="btn btn-block btn-lg" type="submit" style="margin-top: 10px;">
        <span>Create Account</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </form>

    <div style="text-align: center; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-subtle);">
      <span style="font-size: 13.5px; color: var(--text-muted);">
        Already have an account? <a href="/login" style="color: var(--volt); font-weight: 700;">Sign in here</a>
      </span>
    </div>
  </div>
</div>
