<div class="wrap" style="padding-top: 20px; padding-bottom: 40px;">
  <div class="form-card reveal">
    <div style="text-align: center; margin-bottom: 24px;">
      <div class="logo-badge" style="margin: 0 auto 12px; width: 36px; height: 36px;">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor">
          <path d="M4 6h16M4 12h11M4 18h6" stroke="var(--volt)" stroke-width="2.6" stroke-linecap="round"/>
        </svg>
      </div>
      <h1 style="font-size: 26px; margin-bottom: 4px;">Welcome Back</h1>
      <p class="form-sub" style="margin-bottom: 0;">Log in to access your roster and reserve floor sessions.</p>
    </div>

    <form action="/login" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="field">
        <label for="email">Email Address</label>
        <input id="email" name="email" type="email" value="<%= form.email || '' %>" placeholder="member@forgefit.club" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="••••••••••••" required autocomplete="current-password" />
      </div>
      <button class="btn btn-block btn-lg" type="submit" style="margin-top: 10px;">
        <span>Sign In</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </form>

    <div style="text-align: center; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-subtle); display: flex; flex-direction: column; gap: 8px;">
      <a href="/forgot-password" class="faint" style="font-size: 13.5px;">Forgot your password?</a>
      <span style="font-size: 13.5px; color: var(--text-muted);">
        Not a member yet? <a href="/register" style="color: var(--volt); font-weight: 700;">Join ForgeFit</a>
      </span>
    </div>
  </div>
</div>
