<!-- ==================== THE FORGEFIT STANDARD (BENTO) ==================== -->
<section class="section" id="standard" style="background: rgba(8, 11, 16, 0.6); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
  <div class="wrap">
    <div class="section-head-center reveal">
      <span class="kicker-lime">THE FORGEFIT STANDARD</span>
      <h2 class="section-heading" style="margin-top: 8px;">Obsessive Attention To Detail</h2>
      <p class="section-lead-muted" style="max-width: 600px; margin: 10px auto 0;">We dismantled the traditional commercial gym model to engineer an intentional training sanctuary.</p>
    </div>

    <div class="bento-grid stagger-group" style="margin-top: 48px;">
      <div class="bento-card">
        <div class="bento-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
        </div>
        <h3>Coach-Led, Rep by Rep</h3>
        <p>Zero unsupervised floor time. Every single session is periodized, programmed, and coached by certified faculty.</p>
      </div>

      <div class="bento-card">
        <div class="bento-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3>Strictly Capped Roster</h3>
        <p>Maximum 16 athletes per conditioning block. You never fight for equipment, and your movement patterns are closely watched.</p>
      </div>

      <div class="bento-card">
        <div class="bento-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <h3>Biometric Benchmarking</h3>
        <p>Regular DEXA body composition, VO2 max testing, and force plate power metrics to validate quantifiable progression.</p>
      </div>

      <div class="bento-card">
        <div class="bento-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
        </div>
        <h3>Contrast Thermal Therapy</h3>
        <p>Finnish dry cedar saunas, cold plunge pools at 8&deg;C, and Normatec compression boots included in your training regimen.</p>
      </div>
    </div>
  </div>
</section>

<!-- ==================== FACULTY / MASTER COACHES ==================== -->
<section class="section" id="coaches">
  <div class="wrap">
    <div class="programs-header reveal">
      <div>
        <span class="kicker-lime">MASTER COACHES</span>
        <h2 class="section-heading">Guided by Elite Faculty</h2>
        <p class="section-lead-muted" style="margin-top: 8px;">National-level weightlifters, strength scientists, and mobility authorities.</p>
      </div>
      <a class="btn-all-classes" href="/trainers">
        <span>All Coaches</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

    <% if (trainers && trainers.length) { %>
    <div class="grid-3 stagger-group" style="margin-top: 40px;">
      <% trainers.forEach(function(t) { %>
      <div class="card-trainer">
        <div class="trainer-media">
          <img src="<%= t.image || '/img/trainer-vikram.jpg' %>" alt="<%= t.name %>" loading="lazy" />
          <div class="trainer-overlay"></div>
          <div class="trainer-info-floating">
            <h3 class="trainer-name"><%= t.name %></h3>
            <span class="trainer-spec"><%= t.specialty %></span>
          </div>
        </div>
        <div class="trainer-body">
          <p class="trainer-bio"><%= t.bio ? t.bio.substring(0, 115) + '...' : 'Specialized elite strength & movement conditioning coach.' %></p>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>

<!-- ==================== MEMBERSHIP TIERS ==================== -->
<% if (plans && plans.length) { %>
<section class="section" id="plans" style="background: rgba(8, 11, 16, 0.5); border-top: 1px solid var(--border-subtle);">
  <div class="wrap">
    <div class="section-head-center reveal">
      <span class="kicker-lime">MEMBERSHIP TIERS</span>
      <h2 class="section-heading" style="margin-top: 8px;">Transparent, High-Yield Plans</h2>
      <p class="section-lead-muted" style="max-width: 620px; margin: 10px auto 0;">No hidden initiation fees, no locking contracts. Complete access to coaching and recovery suites.</p>
    </div>

    <div class="plans-grid stagger-group" style="margin-top: 48px;">
      <% plans.forEach(function(p, idx) { 
        var isFeatured = p.name.toLowerCase().includes('pro') || idx === 1;
        var features = (p.features || '').split('\n').filter(Boolean);
      %>
      <div class="plan-card <%= isFeatured ? 'featured' : '' %>">
        <% if (isFeatured) { %>
          <div class="featured-pill">Most Selected</div>
        <% } %>
        <h3 class="plan-name"><%= p.name %></h3>
        <div class="plan-price-row">
          <div class="plan-price">₹<%= Number(p.price).toLocaleString('en-IN') %></div>
          <div class="plan-duration"><%= p.duration_days %> days membership</div>
        </div>
        <ul class="plan-features">
          <% features.forEach(function(f) { %>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span><%= f %></span>
          </li>
          <% }) %>
        </ul>
        <a class="btn <%= isFeatured ? 'btn-primary-glow' : 'btn-ghost' %> btn-block" href="/register">Join With <%= p.name %></a>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ==================== VIP CTA BANNER ==================== -->
<section class="section">
  <div class="wrap">
    <div class="vip-cta reveal">
      <span class="kicker-lime">FIRST WEEK ON US</span>
      <h2>Experience The Difference Firsthand.</h2>
      <p>Zero credit card commitment. Step onto the turf, complete your initial biometric movement screening, and train with our master coaches for 7 days.</p>
