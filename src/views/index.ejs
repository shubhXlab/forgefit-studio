        <a class="btn-primary-glow" href="/register" style="padding: 14px 34px; font-size: 15px;">Claim Free 7-Day Pass</a>
        <a class="btn-watch-video" href="/contact" style="padding: 14px 28px; font-size: 15px;">Book Studio Walkthrough &rarr;</a>
      </div>
    </div>
  </div>
</section>
