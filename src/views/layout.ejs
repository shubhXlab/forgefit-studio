<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= title %> · <%= siteName %></title>
<meta name="description" content="<%= siteName %> — High-performance athletic club. Olympic lifting bays, HYROX turf, and biometric recovery." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Outfit:wght@500;600;700;800;900&family=Reenie+Beanie&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/style.css" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23050708' stroke='%23B7FF00' stroke-width='2'/%3E%3Cpath d='M8 9h16M8 16h11M8 23h7' stroke='%23B7FF00' stroke-width='2.5' stroke-linecap='round'/%3E%3C/svg%3E" />
</head>
<body id="top">

<!-- Floating Glass Navigation Bar -->
<header class="site-header" id="siteHeader">
  <div class="wrap header-inner">
    <!-- Brand Logo with Minimal Abstract 3-Line F Symbol -->
    <a class="site-logo" href="/" aria-label="<%= siteName %> Home">
      <div class="logo-mark" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
          <path d="M4 6h16M4 12h12M4 18h7" stroke="#B7FF00" stroke-width="3" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="logo-text">FORGE<span class="logo-lime">FIT</span></span>
    </a>

    <!-- Center Navigation Track with Subtle Lime Pill Indicator -->
    <nav class="site-nav" id="mainNav">
      <a href="/" class="nav-link <%= currentPath==='/'?'active':'' %>">Home</a>
      <a href="/classes" class="nav-link <%= currentPath.startsWith('/classes')?'active':'' %>">Classes</a>
      <a href="/trainers" class="nav-link <%= currentPath.startsWith('/trainers')?'active':'' %>">Coaches</a>
      <a href="/plans" class="nav-link <%= currentPath.startsWith('/plans')?'active':'' %>">Memberships</a>
      <a href="/about" class="nav-link <%= currentPath.startsWith('/about')?'active':'' %>">About</a>
      <a href="/contact" class="nav-link <%= currentPath.startsWith('/contact')?'active':'' %>">Contact</a>
    </nav>

    <!-- Right Header Actions (Search Icon, Login, Bright Neon CTA) -->
    <div class="header-actions">
      <button class="nav-search-btn" id="searchBtn" type="button" aria-label="Search studio timetable">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <% if (user) { %>
        <% if (user.role === 'admin') { %>
          <a class="nav-login-btn" href="/admin" style="color:#B7FF00;border-color:rgba(183,255,0,0.4);">Admin</a>
        <% } %>
        <a class="nav-login-btn" href="/dashboard">Dashboard</a>
        <form action="/logout" method="post" class="inline-form" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="nav-login-btn" type="submit" style="color:var(--text-faint);">Logout</button>
        </form>
      <% } else { %>
        <a class="nav-login-btn" href="/login">Login</a>
        <a class="btn-claim-free" href="/register">
          <span>Claim Free Week</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      <% } %>

      <!-- Mobile Hamburger Toggle -->
      <button class="nav-toggle" id="navToggle" type="button" aria-label="Toggle navigation menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Quick Search Modal Overlay -->
<div class="search-modal-overlay" id="searchModal" aria-hidden="true">
  <div class="search-modal-box">
    <div class="search-input-wrap">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#B7FF00" stroke-width="2.5">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="searchInput" placeholder="Search classes, coaches, recovery suites..." autocomplete="off" />
      <button type="button" class="search-close-btn" id="searchCloseBtn">&times;</button>
    </div>
    <div class="search-results-list" id="searchResults">
      <a href="/classes" class="search-item">
        <strong>Olympic Strength Progression</strong>
        <span>Barbell mechanics, power cleans, squats</span>
      </a>
      <a href="/classes" class="search-item">
        <strong>HYROX Engine &amp; Turf Conditioning</strong>
        <span>Sleds, rowers, SkiErg intervals</span>
      </a>
      <a href="/classes" class="search-item">
        <strong>Athletic Mobility &amp; Contrast Recovery</strong>
        <span>Cedar saunas, cold plunge, myofascial release</span>
      </a>
      <a href="/trainers" class="search-item">
        <div style="display: flex; align-items: center; gap: 12px;">
          <img src="/img/trainer-vikram.jpg" alt="Coach Vikram Sen" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border-card); flex-shrink: 0;" />
          <div>
            <strong>Coach Vikram Sen</strong>
            <span style="display: block;">Head Coach &middot; Functional Strength &amp; Conditioning</span>
          </div>
        </div>
      </a>
      <a href="/trainers" class="search-item">
        <div style="display: flex; align-items: center; gap: 12px;">
          <img src="/img/trainer-ananya.jpg" alt="Coach Ananya Sharma" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border-card); flex-shrink: 0;" />
          <div>
            <strong>Coach Ananya Sharma</strong>
            <span style="display: block;">HIIT, Mobility &amp; High-Performance Conditioning</span>
          </div>
        </div>
      </a>
      <a href="/trainers" class="search-item">
        <div style="display: flex; align-items: center; gap: 12px;">
          <img src="/img/trainer-kabir.jpg" alt="Coach Kabir Mehta" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border-card); flex-shrink: 0;" />
          <div>
            <strong>Coach Kabir Mehta</strong>
            <span style="display: block;">Yoga, Breathwork &amp; Athletic Recovery</span>
          </div>
        </div>
      </a>
      <a href="/plans" class="search-item">
        <strong>Biometric Pro Membership</strong>
        <span>All sessions + contrast suites + monthly DEXA</span>
      </a>
    </div>
  </div>
</div>

<!-- Video Showcase Modal Overlay -->
<div class="video-modal-overlay" id="videoModal" aria-hidden="true">
  <div class="video-modal-box">
    <div class="video-modal-header">
      <div class="video-header-tag">
        <span class="live-dot"></span>
        <span>FORGEFIT STUDIO EXPERIENCE &bull; THE ENGINE</span>
      </div>
      <button type="button" class="video-close-btn" id="videoCloseBtn" aria-label="Close video player">&times;</button>
    </div>
    <div class="video-frame-container">
      <video id="videoPlayer" class="video-player" playsinline controls preload="metadata" poster="/img/turf-showcase.jpg">
        <source src="/video/forgefit-trailer.mp4" type="video/mp4" />
        <source src="/video/forgefit-conditioning.mp4" type="video/mp4" />
        Your browser does not support HTML5 video.
      </video>
    </div>
  </div>
</div>

<% if (isAdminPage && user && user.role === 'admin') { %>
<div class="wrap admin-shell">
  <%- include('partials/admin-nav') %>
  <div class="admin-main">
    <%- include('partials/flash') %>
    <%- body %>
  </div>
</div>
<% } else { %>
  <div class="wrap flash-slot"><%- include('partials/flash') %></div>
  <main><%- body %></main>
<% } %>

<!-- Premium Dark Athletic Footer -->
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="site-logo" href="/" style="margin-bottom:14px;">
        <div class="logo-mark" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
            <path d="M4 6h16M4 12h12M4 18h7" stroke="#B7FF00" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </div>
        <span class="logo-text">FORGE<span class="logo-lime">FIT</span></span>
      </a>
      <p class="muted" style="font-size:14px;line-height:1.7;max-width:340px;margin-top:14px;">
        High-performance athletic club. Olympic lifting bays, HYROX metabolic conditioning, biometric benchmarking, and contrast thermal recovery.
      </p>
      <div style="margin-top:18px;display:flex;align-items:center;gap:10px;">
        <span class="beacon-dot"></span>
        <span style="font-size:13px;color:var(--text-muted);font-weight:600;">Sanctuary &middot; Indiranagar, Bengaluru</span>
      </div>
    </div>
    <div>
      <h4>Experience</h4>
      <a href="/classes">Studio Timetable</a>
      <a href="/classes">Strength &amp; Lifting</a>
      <a href="/classes">Conditioning / HYROX</a>
      <a href="/classes">Recovery &amp; Mobility</a>
      <a href="/classes">Small Group Cohorts</a>
    </div>
    <div>
      <h4>Coaching &amp; Access</h4>
      <a href="/trainers">Certified Master Coaches</a>
      <a href="/plans">Membership Tiers</a>
      <a href="/about">Coaching Philosophy</a>
      <a href="/contact">Location &amp; Hours</a>
    </div>
    <div>
      <h4>Member Access</h4>
      <% if (user) { %>
        <a href="/dashboard">Member Dashboard</a>
        <a href="/bookings">My Reservations</a>
        <a href="/security">Security &amp; 2FA</a>
      <% } else { %>
        <a href="/login">Member Login</a>
        <a href="/register">Join ForgeFit</a>
        <a href="/forgot-password">Password Reset</a>
      <% } %>
      <a href="mailto:concierge@forgefit.com" style="color:var(--neon-lime);font-weight:700;margin-top:8px;">concierge@forgefit.com</a>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>&copy; <%= new Date().getFullYear() %> <%= siteName %> Athletic Club. All rights reserved.</span>
    <span style="display:flex;align-items:center;gap:18px;">
      <a href="/about" class="faint">Manifesto</a>
      <a href="/contact" class="faint">Concierge</a>
      <a href="#top" style="color:var(--neon-lime);font-weight:700;">Back to top &uarr;</a>
    </span>
  </div>
</footer>

<script src="/js/main.js"></script>
</body>
</html>
