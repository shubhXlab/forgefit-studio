<section class="section" style="padding-top: 40px; padding-bottom: 50px;">
  <div class="wrap">
    <div class="page-hero reveal" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 28px;">
      <div>
        <span class="section-kicker">Member Roster</span>
        <h1 class="section-title">My Bookings</h1>
        <p class="section-subtitle">Track your past attendance and upcoming floor reservations.</p>
      </div>
      <div>
        <a class="btn" href="/classes">+ Book A Class</a>
      </div>
    </div>

    <div class="panel reveal">
      <% if (bookings && bookings.length) { %>
      <div class="table-wrap" style="border: none;">
        <table class="data">
          <thead>
            <tr>
              <th>Class & Coach</th>
              <th>Timetable Slot</th>
              <th>Reservation Date</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(function(b) { %>
            <tr>
              <td>
                <b style="color: #fff; font-size: 15px;"><%= b.title %></b>
                <div class="muted" style="font-size: 13px;">Coach: <%= b.trainer_name %></div>
              </td>
              <td class="muted"><%= b.schedule %></td>
              <td class="muted"><%= new Date(b.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
              <td>
                <span class="badge <%= b.status === 'booked' ? 'info' : b.status === 'attended' ? 'ok' : 'warn' %>">
                  <%= b.status %>
                </span>
              </td>
              <td>
                <% if (b.status === 'booked') { %>
                <form action="/bookings/<%= b.id %>/cancel" method="post" style="display: inline;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-danger btn-sm" data-confirm="Cancel this booking?">Cancel Spot</button>
                </form>
                <% } else { %>
                <span class="muted" style="font-size: 13px;">Closed</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="empty">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: var(--volt-subtle); border: 1px solid var(--volt-border); display: inline-flex; align-items: center; justify-content: center; color: var(--volt); margin-bottom: 14px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <h3>No Reservations Found</h3>
        <p class="muted">You have no active or archived class reservations.</p>
        <a href="/classes" class="btn" style="margin-top: 16px;">Explore Schedule &rarr;</a>
      </div>
      <% } %>
    </div>
  </div>
</section>
