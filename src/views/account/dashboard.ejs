<section class="section" style="padding-top: 40px; padding-bottom: 50px;">
  <div class="wrap">
    <div class="member-hero reveal" style="margin-bottom: 32px;">
      <div>
        <div class="status-indicator-pill" style="margin-bottom: 12px; padding: 4px 12px;">
          <span class="beacon-dot"></span>
          <span>Member Sanctuary Portal</span>
        </div>
        <h1 style="font-size: 28px; margin-bottom: 4px;">Welcome back, <%= user.name %></h1>
        <p class="muted">Your active training blocks, reservations, and membership status.</p>
      </div>
      <div style="display: flex; gap: 10px;">
        <a class="btn btn-ghost btn-sm" href="/profile">Profile Details</a>
        <a class="btn btn-ghost btn-sm" href="/security">Account Security</a>
      </div>
    </div>

    <div class="dash-grid reveal">
      <!-- Left Column: Upcoming Sessions & History -->
      <div>
        <div class="panel">
          <h3>
            <span>Upcoming Reservations</span>
            <a href="/classes" class="btn btn-ghost btn-sm" style="font-weight: 700;">+ Book Session</a>
          </h3>
          <% if (bookings && bookings.length) { %>
            <div style="display: flex; flex-direction: column;">
              <% bookings.forEach(function(b) { %>
              <div class="booking-row">
                <% if (b.image) { %>
                  <img src="<%= b.image %>" alt="<%= b.title %>" />
                <% } else { %>
                  <div style="width: 72px; height: 52px; border-radius: 8px; background: #141820; display: flex; align-items: center; justify-content: center; color: var(--volt);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  </div>
                <% } %>
                <div class="grow">
                  <h4><%= b.title %></h4>
                  <div class="meta">
                    <span><%= b.schedule %></span> &middot; <span>Coach <%= b.trainer_name %></span>
                  </div>
                </div>
                <form action="/bookings/<%= b.id %>/cancel" method="post">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-danger btn-sm" data-confirm="Cancel this reserved spot?">Cancel</button>
                </form>
              </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty" style="padding: 40px 20px;">
              <div style="width: 44px; height: 44px; border-radius: 12px; background: var(--volt-subtle); border: 1px solid var(--volt-border); display: inline-flex; align-items: center; justify-content: center; color: var(--volt); margin-bottom: 12px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <p style="color: var(--text-muted); font-size: 14.5px;">No active class reservations on your calendar.</p>
              <a href="/classes" class="btn btn-sm" style="margin-top: 14px;">Browse Class Roster &rarr;</a>
            </div>
          <% } %>
        </div>

        <% if (past && past.length) { %>
        <div class="panel" style="margin-top: 24px;">
          <h3>Completed / Past Sessions</h3>
          <div style="display: flex; flex-direction: column;">
            <% past.forEach(function(b) { %>
            <div class="booking-row">
              <div class="grow">
                <h4><%= b.title %></h4>
                <div class="meta"><%= new Date(b.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
              </div>
              <span class="badge <%= b.status === 'attended' ? 'ok' : 'warn' %>"><%= b.status %></span>
            </div>
            <% }) %>
          </div>
          <p style="margin-top: 16px;">
            <a href="/bookings" style="color: var(--volt); font-size: 13.5px; font-weight: 700;">View complete attendance record &rarr;</a>
          </p>
        </div>
        <% } %>
      </div>

      <!-- Right Column: Membership & Fast Actions -->
      <div>
        <div class="panel">
          <h3>Active Membership</h3>
          <% if (membership) { %>
            <div style="background: var(--volt-subtle); border: 1px solid var(--volt-border); border-radius: 12px; padding: 20px; margin-bottom: 16px;">
              <span class="badge ok" style="margin-bottom: 8px;">ACTIVE TIER</span>
              <div style="font-family: var(--font-display); font-size: 24px; font-weight: 900; color: #fff;"><%= membership.plan_name %></div>
              <p style="color: var(--text-muted); font-size: 13.5px; margin-top: 4px;">
                Valid until <strong><%= new Date(membership.ends_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %></strong>
              </p>
              <div style="margin-top: 12px; font-size: 13px; color: var(--text-faint);">
                ₹<%= Number(membership.plan_price).toLocaleString('en-IN') %> &middot; <%= membership.duration_days %> Days Cycle
              </div>
            </div>
          <% } else { %>
            <div style="background: var(--bg-surface); border: 1px dashed var(--border-card); border-radius: 12px; padding: 22px; text-align: center; margin-bottom: 16px;">
              <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 14px;">No active membership package attached. Unlock priority reservations and recovery suites.</p>
              <a class="btn btn-sm btn-block" href="/plans">Explore Membership Tiers</a>
            </div>
          <% } %>
        </div>

        <div class="panel" style="margin-top: 24px;">
          <h3>Quick Actions</h3>
          <div style="display: flex; flex-direction: column; gap: 10px;">
            <a class="btn btn-ghost btn-block" href="/classes">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>Book Upcoming Class</span>
            </a>
            <a class="btn btn-ghost btn-block" href="/bookings">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span>Reservation History</span>
            </a>
            <a class="btn btn-ghost btn-block" href="/change-password">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span>Change Password</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
