<aside class="admin-nav">
  <!-- Console Header & Brand -->
  <div class="admin-console-brand">
    <div class="brand-top-row">
      <div class="logo-mark" aria-hidden="true" style="width:28px;height:28px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M4 6h16M4 12h12M4 18h7" stroke="#B7FF00" stroke-width="3" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <div class="console-title">FORGE<span class="logo-lime">FIT</span> <span class="console-tag">CONSOLE</span></div>
      </div>
    </div>
    <div class="console-status-pill">
      <span class="beacon-dot"></span>
      <span>SYSTEM OPERATIONAL</span>
    </div>
  </div>

  <div class="admin-nav-section-label">STUDIO OPERATIONS</div>

  <!-- Navigation Links with SVG Icons -->
  <nav class="admin-nav-links">
    <!-- Overview -->
    <a href="/admin" class="nav-item <%= currentPath === '/admin' ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
      <span>Overview</span>
    </a>

    <!-- Members -->
    <a href="/admin/members" class="nav-item <%= currentPath.startsWith('/admin/members') && !currentPath.startsWith('/admin/memberships') ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
      <span>Members</span>
    </a>

    <!-- Classes -->
    <a href="/admin/classes" class="nav-item <%= currentPath.startsWith('/admin/classes') ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      <span>Classes</span>
    </a>

    <!-- Trainers -->
    <a href="/admin/trainers" class="nav-item <%= currentPath.startsWith('/admin/trainers') ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="4"></circle><path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"></path></svg>
      <span>Trainers</span>
    </a>

    <!-- Plans -->
    <a href="/admin/plans" class="nav-item <%= currentPath.startsWith('/admin/plans') ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      <span>Plans</span>
    </a>

    <!-- Memberships -->
    <a href="/admin/memberships" class="nav-item <%= currentPath.startsWith('/admin/memberships') ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
      <span>Memberships</span>
    </a>

    <!-- Bookings -->
    <a href="/admin/bookings" class="nav-item <%= currentPath.startsWith('/admin/bookings') ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
      <span>Bookings</span>
    </a>

    <!-- Messages (with glowing badge) -->
    <a href="/admin/messages" class="nav-item <%= currentPath.startsWith('/admin/messages') ? 'active' : '' %>" style="display:flex;justify-content:space-between;align-items:center;">
      <div style="display:flex;align-items:center;gap:10px;">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        <span>Messages</span>
      </div>
      <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
        <span class="nav-unread-badge"><%= unreadCount %></span>
      <% } %>
    </a>

    <div class="admin-nav-section-label" style="margin-top:16px;">INTEGRITY &amp; INFRA</div>

    <!-- Security & Audit Command -->
    <a href="/admin/security" class="nav-item <%= currentPath.startsWith('/admin/security') ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#B7FF00" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      <span style="font-weight:700;">Security &amp; Audit</span>
    </a>

    <!-- Settings -->
    <a href="/admin/settings" class="nav-item <%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
      <span>Settings</span>
    </a>

    <!-- phpMyAdmin (External) -->
    <a href="<%= config.phpMyAdminUrl %>" target="_blank" rel="noopener noreferrer" class="nav-item nav-item-phpmyadmin">
      <div style="display:flex;align-items:center;gap:10px;">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
        <span>phpMyAdmin</span>
      </div>
      <span class="db-port-badge">3306 ↗</span>
    </a>
  </nav>

  <!-- Admin User Identity Pill at Bottom -->
  <div class="admin-user-capsule">
    <div class="admin-user-details">
      <div class="admin-user-avatar">
        <%= user ? user.name.charAt(0).toUpperCase() : 'A' %>
      </div>
      <div class="admin-user-meta">
        <strong><%= user ? user.name : 'Administrator' %></strong>
        <span><%= user ? user.email : 'admin@forgefit' %></span>
      </div>
    </div>
    <div class="admin-user-actions">
      <a href="/" class="btn-subtle-link">&larr; Website</a>
      <form action="/logout" method="post" style="display:inline;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn-subtle-link" style="color:#f87171;">Logout</button>
      </form>
    </div>
  </div>
</aside>
